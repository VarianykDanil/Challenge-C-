    "lucide-react": "^0.510.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0",
    "recharts": "^2.15.3",
    "simple-icons": "16.34.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.6",
