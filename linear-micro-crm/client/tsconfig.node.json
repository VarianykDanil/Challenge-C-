{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "types": ["node"]
  },
  "include": ["vite.config.ts", "build/**/*.ts", "sw/policy.test.ts", "sw/handlers.test.ts"]
}
