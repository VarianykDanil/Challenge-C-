{
  "name": "@lm/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "TZ=Europe/London NODE_NO_WARNINGS=1 node --watch src/index.ts",
    "dev:tsx": "TZ=Europe/London NODE_NO_WARNINGS=1 tsx watch src/index.ts",
    "start": "TZ=Europe/London NODE_ENV=production NODE_NO_WARNINGS=1 node src/index.ts",
    "doctor": "NODE_NO_WARNINGS=1 node src/doctor.ts",
    "stop": "NODE_NO_WARNINGS=1 node src/stop.ts",
    "start:tsx": "TZ=Europe/London NODE_ENV=production NODE_NO_WARNINGS=1 tsx src/index.ts",
    "seed": "NODE_NO_WARNINGS=1 node src/db/seed.ts",
    "smoke": "TZ=Europe/London NODE_NO_WARNINGS=1 node src/smoke.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "NODE_NO_WARNINGS=1 node --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@lm/shared": "*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "qrcode": "^1.5.4",
    "tsx": "^4.19.4",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/node": "^22.15.3",
    "@types/qrcode": "^1.5.6",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=22.18"
  }
}
