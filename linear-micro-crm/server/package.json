{
  "name": "@lm/server",
  "version": "1.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "TZ=Europe/London NODE_NO_WARNINGS=1 node --watch src/index.ts",
    "dev:tsx": "TZ=Europe/London NODE_NO_WARNINGS=1 tsx watch src/index.ts",
    "start": "TZ=Europe/London NODE_ENV=production NODE_NO_WARNINGS=1 node src/index.ts",
    "doctor": "NODE_NO_WARNINGS=1 node src/doctor.ts",
    "stop": "NODE_NO_WARNINGS=1 node src/stop.ts",
    "restart": "npm run stop; npm run start",
    "share": "NODE_NO_WARNINGS=1 node src/share.ts",
    "start:tsx": "TZ=Europe/London NODE_ENV=production NODE_NO_WARNINGS=1 tsx src/index.ts",
    "seed": "NODE_NO_WARNINGS=1 node src/db/seed.ts",
    "backup": "NODE_NO_WARNINGS=1 node src/backup.ts",
    "backups": "NODE_NO_WARNINGS=1 node src/backup.ts --list",
    "restore": "NODE_NO_WARNINGS=1 node src/restore.ts",
    "key:restore": "NODE_NO_WARNINGS=1 node src/keyRestore.ts",
    "recovery-sheet": "NODE_NO_WARNINGS=1 node src/recoverySheet.ts",
    "pin:reset": "NODE_NO_WARNINGS=1 node src/pinReset.ts",
    "2fa:reset": "NODE_NO_WARNINGS=1 node src/twoFactorReset.ts",
    "service:install": "NODE_NO_WARNINGS=1 node src/service.ts install",
    "service:uninstall": "NODE_NO_WARNINGS=1 node src/service.ts uninstall",
    "service:status": "NODE_NO_WARNINGS=1 node src/service.ts status",
    "smoke": "TZ=Europe/London NODE_NO_WARNINGS=1 node src/smoke.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "TZ=Europe/London NODE_NO_WARNINGS=1 node --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@lm/shared": "*",
    "busboy": "1.6.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "imapflow": "2.2.6",
    "jspdf": "4.2.1",
    "mailparser": "3.9.36",
    "pdfjs-dist": "6.4.299",
    "qrcode": "^1.5.4",
    "tsx": "^4.19.4",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/busboy": "1.5.4",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/mailparser": "3.9.0",
    "@types/node": "^22.15.3",
    "@types/qrcode": "^1.5.6",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": "^22.18.0 || ^24.0.0 || ^26.0.0"
  }
}
