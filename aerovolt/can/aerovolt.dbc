CM_ "AeroVolt Formula Student EV telemetry bus. Classic CAN 2.0A, 1 Mbit/s, Intel byte order. Signal names equal AeroVolt channel ids. SNA = most negative raw value (signed) or all ones (unsigned); 1-bit flags have no SNA.";
CM_ BU_ AERO_NODE "Aero sensor node (pressure taps, pitot, ambient, 5-hole probe, ride height, wing load cells)";
CM_ BU_ SUSP_NODE "Suspension node (damper potentiometers, pushrod load cells)";
CM_ BU_ IMU_NODE "Inertial measurement unit near the centre of gravity";
CM_ BU_ GPS_NODE "GNSS receiver (10 Hz)";
CM_ BU_ DASH_NODE "Dashboard / telemetry logger (receives everything, forwards to the pit wall)";
CM_ BU_ INVERTER "Motor inverter";
CM_ BU_ BMS "Battery management system (accumulator)";
CM_ BU_ VCU "Vehicle control unit (pedals, wheel speeds, cooling control, safety chain monitor)";
CM_ BO_ 768 "Front wing pressure taps 1-4 (station L suction side), Pa relative to freestream static. Cycle 20 ms.";
CM_ SG_ 768 fw_p01 "Front wing L tap 1 (suction, x/c 0.05). Sensor range -3200 .. 3200 Pa. SNA (not available) = raw -32768.";
CM_ SG_ 768 fw_p02 "Front wing L tap 2 (suction, x/c 0.20). Sensor range -3200 .. 3200 Pa. SNA (not available) = raw -32768.";
CM_ SG_ 768 fw_p03 "Front wing L tap 3 (suction, x/c 0.45). Sensor range -3200 .. 3200 Pa. SNA (not available) = raw -32768.";
CM_ SG_ 768 fw_p04 "Front wing L tap 4 (suction, x/c 0.75). Sensor range -3200 .. 3200 Pa. SNA (not available) = raw -32768.";
CM_ BO_ 769 "Front wing pressure taps 5-8 (station L pressure side, station R suction side), Pa. Cycle 20 ms.";
CM_ SG_ 769 fw_p05 "Front wing L tap 5 (pressure, x/c 0.10). Sensor range -3200 .. 3200 Pa. SNA (not available) = raw -32768.";
CM_ SG_ 769 fw_p06 "Front wing L tap 6 (pressure, x/c 0.50). Sensor range -3200 .. 3200 Pa. SNA (not available) = raw -32768.";
CM_ SG_ 769 fw_p07 "Front wing R tap 7 (suction, x/c 0.05). Sensor range -3200 .. 3200 Pa. SNA (not available) = raw -32768.";
CM_ SG_ 769 fw_p08 "Front wing R tap 8 (suction, x/c 0.20). Sensor range -3200 .. 3200 Pa. SNA (not available) = raw -32768.";
CM_ BO_ 770 "Front wing pressure taps 9-12 (station R), Pa. Cycle 20 ms.";
CM_ SG_ 770 fw_p09 "Front wing R tap 9 (suction, x/c 0.45). Sensor range -3200 .. 3200 Pa. SNA (not available) = raw -32768.";
CM_ SG_ 770 fw_p10 "Front wing R tap 10 (suction, x/c 0.75). Sensor range -3200 .. 3200 Pa. SNA (not available) = raw -32768.";
CM_ SG_ 770 fw_p11 "Front wing R tap 11 (pressure, x/c 0.10). Sensor range -3200 .. 3200 Pa. SNA (not available) = raw -32768.";
CM_ SG_ 770 fw_p12 "Front wing R tap 12 (pressure, x/c 0.50). Sensor range -3200 .. 3200 Pa. SNA (not available) = raw -32768.";
CM_ BO_ 771 "Rear wing pressure taps 1-4 (station L suction side), Pa. Cycle 20 ms.";
CM_ SG_ 771 rw_p01 "Rear wing L tap 1 (suction, x/c 0.05). Sensor range -3200 .. 3200 Pa. SNA (not available) = raw -32768.";
CM_ SG_ 771 rw_p02 "Rear wing L tap 2 (suction, x/c 0.20). Sensor range -3200 .. 3200 Pa. SNA (not available) = raw -32768.";
CM_ SG_ 771 rw_p03 "Rear wing L tap 3 (suction, x/c 0.45). Sensor range -3200 .. 3200 Pa. SNA (not available) = raw -32768.";
CM_ SG_ 771 rw_p04 "Rear wing L tap 4 (suction, x/c 0.75). Sensor range -3200 .. 3200 Pa. SNA (not available) = raw -32768.";
CM_ BO_ 772 "Rear wing pressure taps 5-8, Pa. Cycle 20 ms.";
CM_ SG_ 772 rw_p05 "Rear wing L tap 5 (pressure, x/c 0.10). Sensor range -3200 .. 3200 Pa. SNA (not available) = raw -32768.";
CM_ SG_ 772 rw_p06 "Rear wing L tap 6 (pressure, x/c 0.50). Sensor range -3200 .. 3200 Pa. SNA (not available) = raw -32768.";
CM_ SG_ 772 rw_p07 "Rear wing R tap 7 (suction, x/c 0.05). Sensor range -3200 .. 3200 Pa. SNA (not available) = raw -32768.";
CM_ SG_ 772 rw_p08 "Rear wing R tap 8 (suction, x/c 0.20). Sensor range -3200 .. 3200 Pa. SNA (not available) = raw -32768.";
CM_ BO_ 773 "Rear wing pressure taps 9-12 (station R), Pa. Cycle 20 ms.";
CM_ SG_ 773 rw_p09 "Rear wing R tap 9 (suction, x/c 0.45). Sensor range -3200 .. 3200 Pa. SNA (not available) = raw -32768.";
CM_ SG_ 773 rw_p10 "Rear wing R tap 10 (suction, x/c 0.75). Sensor range -3200 .. 3200 Pa. SNA (not available) = raw -32768.";
CM_ SG_ 773 rw_p11 "Rear wing R tap 11 (pressure, x/c 0.10). Sensor range -3200 .. 3200 Pa. SNA (not available) = raw -32768.";
CM_ SG_ 773 rw_p12 "Rear wing R tap 12 (pressure, x/c 0.50). Sensor range -3200 .. 3200 Pa. SNA (not available) = raw -32768.";
CM_ BO_ 774 "Undertray centreline taps 1-4 (inlet to throat), Pa. Cycle 20 ms.";
CM_ SG_ 774 ut_p01 "Undertray tap 1 (inlet, 0.05). Sensor range -3200 .. 3200 Pa. SNA (not available) = raw -32768.";
CM_ SG_ 774 ut_p02 "Undertray tap 2 (0.20). Sensor range -3200 .. 3200 Pa. SNA (not available) = raw -32768.";
CM_ SG_ 774 ut_p03 "Undertray tap 3 (throat, 0.40). Sensor range -3200 .. 3200 Pa. SNA (not available) = raw -32768.";
CM_ SG_ 774 ut_p04 "Undertray tap 4 (0.60). Sensor range -3200 .. 3200 Pa. SNA (not available) = raw -32768.";
CM_ BO_ 775 "Undertray taps 5-8 (diffuser centreline and tunnels), Pa. Cycle 20 ms.";
CM_ SG_ 775 ut_p05 "Undertray tap 5 (diffuser, 0.80). Sensor range -3200 .. 3200 Pa. SNA (not available) = raw -32768.";
CM_ SG_ 775 ut_p06 "Undertray tap 6 (diffuser exit, 0.97). Sensor range -3200 .. 3200 Pa. SNA (not available) = raw -32768.";
CM_ SG_ 775 ut_p07 "Undertray tap 7 (left tunnel, 0.80). Sensor range -3200 .. 3200 Pa. SNA (not available) = raw -32768.";
CM_ SG_ 775 ut_p08 "Undertray tap 8 (right tunnel, 0.80). Sensor range -3200 .. 3200 Pa. SNA (not available) = raw -32768.";
CM_ BO_ 784 "Pitot dynamic pressure (50 Hz) and BME280 ambient air data (updated at 1 Hz). Cycle 20 ms.";
CM_ SG_ 784 pitot_dp "Pitot dynamic pressure. Sensor range -500 .. 3200 Pa. SNA (not available) = raw -32768.";
CM_ SG_ 784 amb_temp "Ambient temperature. Sensor range -20 .. 60 °C. SNA (not available) = raw -32768.";
CM_ SG_ 784 amb_press "Ambient pressure (absolute). Sensor range 50000 .. 110000 Pa. SNA (not available) = raw 65535.";
CM_ SG_ 784 amb_rh "Ambient relative humidity. Sensor range 0 .. 100 %. SNA (not available) = raw 255.";
CM_ BO_ 785 "5-hole probe flow angles and laser ride heights. Cycle 20 ms.";
CM_ SG_ 785 probe_yaw "Flow yaw angle (5-hole probe). Sensor range -30 .. 30 deg. SNA (not available) = raw -32768.";
CM_ SG_ 785 probe_pitch "Flow pitch angle (5-hole probe). Sensor range -30 .. 30 deg. SNA (not available) = raw -32768.";
CM_ SG_ 785 rh_front "Ride height front (laser). Sensor range 0 .. 100 mm. SNA (not available) = raw 65535.";
CM_ SG_ 785 rh_rear "Ride height rear (laser). Sensor range 0 .. 100 mm. SNA (not available) = raw 65535.";
CM_ BO_ 786 "Wing mount load cells, vertical force, + = down. Cycle 20 ms.";
CM_ SG_ 786 fw_load "Front wing mount load (vertical, +down). Sensor range -500 .. 3000 N. SNA (not available) = raw -32768.";
CM_ SG_ 786 rw_load "Rear wing mount load (vertical, +down). Sensor range -500 .. 3000 N. SNA (not available) = raw -32768.";
CM_ BO_ 800 "Damper positions from static, + = bump. Cycle 10 ms.";
CM_ SG_ 800 damper_fl "Damper position FL (+bump). Sensor range -40 .. 60 mm. SNA (not available) = raw -32768.";
CM_ SG_ 800 damper_fr "Damper position FR (+bump). Sensor range -40 .. 60 mm. SNA (not available) = raw -32768.";
CM_ SG_ 800 damper_rl "Damper position RL (+bump). Sensor range -40 .. 60 mm. SNA (not available) = raw -32768.";
CM_ SG_ 800 damper_rr "Damper position RR (+bump). Sensor range -40 .. 60 mm. SNA (not available) = raw -32768.";
CM_ BO_ 801 "Pushrod compression forces. Cycle 10 ms.";
CM_ SG_ 801 pushrod_fl "Pushrod force FL (compression). Sensor range -500 .. 8000 N. SNA (not available) = raw -32768.";
CM_ SG_ 801 pushrod_fr "Pushrod force FR (compression). Sensor range -500 .. 8000 N. SNA (not available) = raw -32768.";
CM_ SG_ 801 pushrod_rl "Pushrod force RL (compression). Sensor range -500 .. 8000 N. SNA (not available) = raw -32768.";
CM_ SG_ 801 pushrod_rr "Pushrod force RR (compression). Sensor range -500 .. 8000 N. SNA (not available) = raw -32768.";
CM_ BO_ 816 "Accelerations in the vehicle frame (ISO 8855), az = +9.81 at rest. Cycle 10 ms.";
CM_ SG_ 816 ax "Longitudinal acceleration (+forward). Sensor range -50 .. 50 m/s². SNA (not available) = raw -32768.";
CM_ SG_ 816 ay "Lateral acceleration (+left). Sensor range -50 .. 50 m/s². SNA (not available) = raw -32768.";
CM_ SG_ 816 az "Vertical acceleration (+9.81 at rest). Sensor range -50 .. 50 m/s². SNA (not available) = raw -32768.";
CM_ BO_ 817 "Angular rates: roll, pitch, yaw. Cycle 10 ms.";
CM_ SG_ 817 gx "Roll rate. Sensor range -250 .. 250 deg/s. SNA (not available) = raw -32768.";
CM_ SG_ 817 gy "Pitch rate. Sensor range -250 .. 250 deg/s. SNA (not available) = raw -32768.";
CM_ SG_ 817 gz "Yaw rate. Sensor range -250 .. 250 deg/s. SNA (not available) = raw -32768.";
CM_ BO_ 832 "GNSS position (WGS-84). Cycle 100 ms.";
CM_ SG_ 832 gps_lat "GPS latitude. Sensor range -90 .. 90 deg. SNA (not available) = raw -2147483648.";
CM_ SG_ 832 gps_lon "GPS longitude. Sensor range -180 .. 180 deg. SNA (not available) = raw -2147483648.";
CM_ BO_ 833 "GNSS ground speed and heading (0 = north, clockwise). Cycle 100 ms.";
CM_ SG_ 833 gps_speed "GPS ground speed. Sensor range 0 .. 60 m/s. SNA (not available) = raw 65535.";
CM_ SG_ 833 gps_heading "GPS heading (0 = north, clockwise). Sensor range 0 .. 360 deg. SNA (not available) = raw 65535.";
CM_ BO_ 848 "Wheel surface speeds. Cycle 20 ms.";
